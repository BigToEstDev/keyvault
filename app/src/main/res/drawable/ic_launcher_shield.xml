<?xml version="1.0" encoding="utf-8"?>
<!--
The foreground of the launcher icon: the shield with a keyhole of the app's screens (ShieldImage, the same
paths in its 120 x 120 viewport), scaled into the safe zone of an adaptive icon - the circle of 66 in 108 that
no launcher mask cuts.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.54"
        android:scaleY="0.54"
        android:translateX="21.6"
        android:translateY="21.6">
        <!-- The shield -->
        <path
            android:fillColor="@color/icon_shield"
            android:pathData="M60,6 L104,22 V56 C104,84 86,104 60,114 C34,104 16,84 16,56 V22 Z" />
        <!-- Its right half a shade darker, for depth -->
        <path
            android:fillAlpha="0.12"
            android:fillColor="@color/icon_shade"
            android:pathData="M60,6 L104,22 V56 C104,84 86,104 60,114 Z" />
        <!-- The keyhole: a round head and a tapering stem -->
        <path
            android:fillColor="@color/icon_keyhole"
            android:pathData="M47,50 a13,13 0 1,1 26,0 a13,13 0 1,1 -26,0 Z M55,58 L51,84 H69 L65,58 Z" />
    </group>
</vector>
